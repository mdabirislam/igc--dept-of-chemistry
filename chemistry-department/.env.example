# Backend API (Django). Required for `next start` / production builds;
# `npm run dev` falls back to http://127.0.0.1:8000/api.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Public address of this site (canonical URLs, sitemap, Open Graph).
# In production set it to the real domain, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
