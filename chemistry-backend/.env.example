# Local development defaults
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_TIME_ZONE=Asia/Dhaka
DJANGO_ENABLE_HSTS=False

# PythonAnywhere production example
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://igc-dept-of-chemistry.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://igc-dept-of-chemistry.vercel.app
# DJANGO_ENABLE_HSTS=True
